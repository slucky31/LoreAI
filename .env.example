# Copier ce fichier en .env (non versionné) et renseigner les valeurs réelles.

# Token API Raindrop.io (App Management Console -> Test token, n'expire pas)
Raindrop__Token=
# 0 = toute la collection hors corbeille
Raindrop__CollectionId=0

# Cle API Anthropic (console.anthropic.com)
Classifier__ApiKey=
Classifier__Model=claude-haiku-4-5

# URL du webhook Discord (Parametres du salon -> Integrations -> Webhooks)
Discord__WebhookUrl=

# SMTP pour le digest quotidien
Email__SmtpHost=
Email__SmtpPort=587
Email__SmtpUser=
Email__SmtpPassword=
Email__FromAddress=
Email__ToAddress=
Email__UseSsl=true

# Planification (expressions cron) et options du worker
Worker__PollingCronExpression=*/15 * * * *
Worker__DigestCronExpression=0 7 * * *
Worker__WriteBackToRaindrop=false
