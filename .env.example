# Copier ce fichier en .env (non versionné) et renseigner les valeurs réelles.

# Connexion a l'instance PostgreSQL mutualisee du Pi (ADR 0009, ADR 0011). Role proprietaire "loreai",
# cree manuellement sur l'instance (voir docs/deploiement-raspberry-pi.md) - jamais le role loreai_ro,
# reserve en lecture seule au futur serveur MCP (lot 3). Host = nom du conteneur Postgres ("pg_main" sur
# l'instance actuelle) sur le reseau Docker externe partage (pi-postgres), pas une adresse Tailscale :
# les deux conteneurs sont colocalises et se joignent par le DNS interne de ce reseau.
Postgres__ConnectionString=Host=pg_main;Port=5432;Database=loreai;Username=loreai;Password=

# Token API Raindrop.io (App Management Console -> Test token, n'expire pas)
Raindrop__Token=
# -1 = "Non trie" : le seul perimetre que l'outil doit toucher. Ne changez cette
# valeur que si vous savez ce que vous faites : 0 vise TOUTE la bibliotheque hors
# corbeille, donc les raindrops que vous avez deja ranges a la main.
Raindrop__CollectionId=-1

# Cle API Anthropic (console.anthropic.com)
Classifier__ApiKey=
Classifier__Model=claude-haiku-4-5

# URL du webhook Discord (Parametres du salon -> Integrations -> Webhooks) : alerte immediate
# (articles ATester/Haute), compte-rendu de fin de cycle (#31) et rapport hebdomadaire d'insights
# en piece jointe (#43).
Discord__WebhookUrl=

# Planification (expressions cron) et options du worker
Worker__PollingCronExpression=*/15 * * * *
# Volontairement a false dans cet exemple (le defaut du code est true) : observez
# d'abord les suggestions dans les logs, puis passez a true pour laisser l'outil
# modifier reellement vos raindrops.
Worker__WriteBackToRaindrop=false
# Age maximal (minutes) d'un cycle termine avant que le healthcheck Docker (#35) ne
# declare le worker en panne. Defaut : 3x le cron de polling par defaut.
Worker__HealthMaxCycleAgeMinutes=45
# Indexation en lecture seule de toute la bibliotheque Raindrop (lot 1, #42) : declenchement
# rare (defaut chaque dimanche 3h UTC), jamais de classification ni d'ecriture chez Raindrop.
Worker__LibraryIndexCronExpression=0 3 * * 0
# A true pour lancer aussi une passe au demarrage du worker (soumise a une garde de 24h :
# ignoree si la derniere passe complete date de moins de 24h).
Worker__IndexLibraryOnStartup=false
# Rapport hebdomadaire d'insights (doublons, tags, collections desequilibrees, tendances,
# cout LLM - lot 2, #43). Defaut : une heure apres l'indexation de la bibliotheque.
Worker__WeeklyInsightsCronExpression=0 4 * * 0
# Revue mensuelle narrative (S4, lot 5, #46) : revoit le mois calendaire precedent, un appel LLM
# par theme (collection suggeree). Defaut : le 1er de chaque mois, une heure apres le rapport hebdomadaire.
Worker__MonthlyReviewCronExpression=0 5 1 * *

# --- Connecteur newsletters Gmail (lot 8, #49) : desactive par defaut, la section Gmail__* ci-dessous
# n'est validee au demarrage que si Worker__EmailIngestionEnabled=true (evite qu'un deploiement sans
# client OAuth Google configure echoue au demarrage).
Worker__EmailIngestionEnabled=false
Worker__EmailIngestionCronExpression=0 * * * *

# Client OAuth Google (console.cloud.google.com -> APIs & Services -> Identifiants) avec l'API Gmail
# activee, scope strictement gmail.readonly. RefreshToken s'obtient une seule fois par consentement
# interactif hors LoreAI (le worker ne fait jamais de flux OAuth interactif) - voir README pour la
# procedure. Label : nom exact d'un label Gmail pose en amont par un filtre (LoreAI ne trie pas le
# inbox lui-meme, il fait confiance a ce label).
Gmail__ClientId=
Gmail__ClientSecret=
Gmail__RefreshToken=
Gmail__Label=

# --- Connecteur RSS via Miniflux (lot 7, #48) : desactive par defaut, la section Miniflux__* ci-dessous
# n'est validee au demarrage que si Worker__FeedIngestionEnabled=true (evite qu'un deploiement sans
# instance Miniflux configuree echoue au demarrage).
Worker__FeedIngestionEnabled=false
Worker__FeedIngestionCronExpression=0 * * * *

# Adresse interne du conteneur Miniflux (voir docker-compose.yml, service "miniflux") - DNS du reseau
# Docker partage, pas une adresse Tailscale : les deux conteneurs sont colocalises.
Miniflux__BaseUrl=http://miniflux:8080
# Jeton API genere une fois dans l'UI Miniflux (Settings -> API Keys) - voir README pour la procedure
# complete (creation du compte admin, ajout des flux, seed du curseur PollingStates).
Miniflux__ApiToken=

# --- Deploiement du conteneur "miniflux" lui-meme (docker-compose.yml) : base et role dedies sur
# l'instance PostgreSQL mutualisee (ADR 0009), jamais la base "loreai" - voir
# docs/deploiement-raspberry-pi.md pour le provisionnement SQL complet.
MINIFLUX_DATABASE_URL=postgres://miniflux:@pg_main:5432/miniflux?sslmode=disable
# Compte admin cree au tout premier demarrage (CREATE_ADMIN=1, idempotent) - sert a se connecter a l'UI
# Miniflux pour ajouter des flux et generer le jeton API ci-dessus.
MINIFLUX_ADMIN_USERNAME=
MINIFLUX_ADMIN_PASSWORD=

# --- Serveur MCP en lecture seule (lot 3, #44, ADR 0014) : conteneur "loreai-mcp" separe, voir
# docker-compose.yml. Ne concerne pas le worker "loreai" ci-dessus.

# Connexion au role loreai_ro (deja provisionne, docs/deploiement-raspberry-pi.md section 3) - jamais
# le role proprietaire "loreai" utilise plus haut. Meme host/port/base que Postgres__ConnectionString,
# username/password differents.
MCP_POSTGRES_CONNECTION_STRING=Host=pg_main;Port=5432;Database=loreai;Username=loreai_ro;Password=

# Jeton bearer statique attendu par le serveur MCP (defense en profondeur derriere le tailnet, D2/ADR
# 0010) : a generer une fois, par ex. `openssl rand -hex 32`, puis a reporter dans le .mcp.json cote
# poste de developpement (voir docs/deploiement-raspberry-pi.md).
MCP_BEARER_TOKEN=

# Adresse Tailscale du Pi sur laquelle le port MCP est publie - jamais 0.0.0.0 (D2/ADR 0010). A obtenir
# sur mcm8 avec `tailscale ip -4`. Reutilisee telle quelle par le service "miniflux" (lot 7, #48) : un
# seul Pi, meme garde-fou reseau.
MCP_TAILSCALE_BIND_IP=
